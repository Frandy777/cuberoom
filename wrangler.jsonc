{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuberoom",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "CubeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CubeRoom"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": false },
}
