{
  "name": "cuberoom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc -b",
    "test:integration": "CUBEROOM_URL=http://127.0.0.1:5173 vitest run tests/room.integration.test.ts",
    "format": "prettier --write src shared worker tests *.ts *.json *.jsonc README.md index.html"
  },
  "dependencies": {
    "cubing": "^0.63.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uqr": "^0.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0",
    "ws": "^8.22.0"
  }
}
